{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cetli",
  "version": "0.1.0",
  "identifier": "org.cetli.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:45834",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Cetli",
        "url": "index.html",
        "width": 960,
        "height": 760,
        "minWidth": 360,
        "minHeight": 240,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "quicklog",
        "title": "Cetli Quick Log",
        "url": "index.html?window=quicklog",
        "width": 560,
        "height": 164,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Plain-text todo lists, TodoPaper style",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["taskpaper", "todopaper"],
        "name": "TaskPaper document",
        "description": "TaskPaper / TodoPaper todo list",
        "role": "Editor"
      }
    ]
  }
}
